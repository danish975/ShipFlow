# Environment
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://mongodb:27017/shipflow

# JWT
JWT_SECRET=shipflow-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# RabbitMQ
RABBITMQ_URL=amqp://shipflow:shipflow@rabbitmq:5672
RABBITMQ_EXCHANGE=shipflow.events
RABBITMQ_NOTIFICATION_QUEUE=shipflow.notifications
RABBITMQ_TRACKING_QUEUE=shipflow.tracking
RABBITMQ_ANALYTICS_QUEUE=shipflow.analytics
RABBITMQ_DLX=shipflow.dlx
RABBITMQ_DLQ=shipflow.dlq

# Client
CLIENT_URL=http://localhost
SOCKET_URL=http://localhost

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
